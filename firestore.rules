rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || request.auth.token.email == 'baakbook01@gmail.com');
    }

    function validDirectOrder() {
      return request.resource.data.keys().hasAll(['status', 'items', 'customer', 'delivery', 'subtotal', 'deliveryFee', 'total', 'currency'])
        && request.resource.data.status == 'new'
        && request.resource.data.currency == 'DZD'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.delivery is map
        && request.resource.data.delivery.wilaya is int
        && request.resource.data.delivery.delivery_type in ['stop_desk', 'domicile']
        && request.resource.data.subtotal is int
        && request.resource.data.subtotal >= 0
        && request.resource.data.deliveryFee is int
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.total is int
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryFee;
    }

    function validProductPublicFields() {
      return request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.availability_type in ['in_stock', 'on_demand']
        && request.resource.data.stock_quantity is int
        && request.resource.data.stock_quantity >= 0
        && request.resource.data.lead_time_min_days is int
        && request.resource.data.lead_time_min_days >= 0
        && request.resource.data.lead_time_min_days <= 1
        && request.resource.data.lead_time_max_days is int
        && request.resource.data.lead_time_max_days >= request.resource.data.lead_time_min_days
        && request.resource.data.lead_time_max_days <= 1;
    }

    match /products/{productId} {
      allow read: if isAdmin() || (resource.data.active == true && resource.data.archived != true);
      allow create, update: if isAdmin() && validProductPublicFields();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active != false;
      allow create, update, delete: if isAdmin();
    }

    match /deliveryFees/{deliveryFeeId} {
      allow read: if isAdmin() || resource.data.active != false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/public {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if validDirectOrder();
      allow update, delete: if isAdmin();
    }

    match /imageLibrary/{imageId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /migrationMetadata/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
